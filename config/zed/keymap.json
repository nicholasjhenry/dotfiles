[
  // ⇧+Enter in the terminal** sends the raw bytes `ESC` + carriage return (`\u001b` is Escape, `\r`
  // is Return). This is the "meta+enter" escape sequence — REPLs and tools like Elixir's IEx or
  // shells with multi-line editing use it to insert a newline *without submitting*, or to trigger
  // an alt-enter action. Without this, ⇧+Enter in a terminal usually just acts like plain Enter.
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b\r"],
    },
  },
  {
    "context": "Panel",
    "bindings": {
      "ctrl-backspace": "editor::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-backspace": "editor::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-r": "task::Rerun"
    }
  }
]
