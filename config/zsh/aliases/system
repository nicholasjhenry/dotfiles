# Jump back to the previous working directory. The leading `--` stops zsh
# parsing `-` as a flag for `alias` itself.
alias -- -='cd -'

# Flush the macOS DNS cache.
alias flushcache='dscacheutil -flushcache'

# Open a URL or file in Google Chrome.
#
# USAGE
#   ch <url|path>
#
# EXAMPLES
#   ch https://example.com
#   ch index.html
alias ch="/usr/bin/open -a /Applications/Google\ Chrome.app"

# Symlink each given directory into a target directory. Paths are globbed by
# the caller, so non-directories in the expansion are skipped. Dot directories
# are skipped too, in case GLOB_DOTS is set. `:A` makes the link targets
# absolute, since a relative target resolves from the link's location, not the
# caller's.
#
# The indexed loop stands in for zsh's `$@[1,-2]` slice, which shfmt cannot
# parse.
#
# USAGE
#   link_dirs <dir>... <target>
#
# EXAMPLES
#   link_dirs ~/src/* ~/links
#   link_dirs ~/src/elixir_* ~/links
function link_dirs() {
  local target=${argv[$#]} i
  for ((i = 1; i < $#; i++)); do
    if [[ -d ${argv[i]} && ${argv[i]:t} != .* ]]; then
      ln -sfn "${argv[i]:A}" "$target"/
    fi
  done
}
