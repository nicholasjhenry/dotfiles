# Use Ctrl-V to determine key codes
#
# Custom widgets go behind the ^O leader (see widgets). ^O is unused in viins,
# and unlike ^X it is not the tmux prefix. Never bind ^O on its own — as a pure
# prefix zsh waits for the next key instead of racing KEYTIMEOUT.
bindkey -M viins -r '^O' # drop the default self-insert, else ^O stalls 0.4s

# Substring search plugin. Maps up and down arrows.
bindkey -M main '^[OA' history-substring-search-up   # ↑
bindkey -M main '^[OB' history-substring-search-down # ↓

# CLI navigation
bindkey '^[[1;5D' backward-word # Ctrl+←
bindkey '^[[1;5C' forward-word  # Ctrl+→
bindkey '^K' kill-line          # Ctrl+k

# Open the current command in your $EDITOR (e.g., neovim)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line # ␛ then v

# Expand history expressions like !! or !$ when you press space
bindkey ' ' magic-space
